[EVENT]
Id=ev_adv_exp_04
Name=Consejo del Explorador: Ruinas de un Santuario Oculto
Description=Varro halló las ruinas de un altar fronterizo. Asegura que excavar el sepulcro de los antiguos caudillos rendirá armas y oro, pero Vitelio advierte maldiciones.
Trigger=ADVICE
Probability=2
MinInfamy=0
MaxInfamy=100
MinGold=0
MinFood=0
MinWater=0
MinArmySize=0

[OPTION_1]
Text=Autorizar a Varro a saquear el sepulcro por botín
Result_pool=res_adv_exp_04_acc_clean:60,res_adv_exp_04_acc_cost:40

[OPTION_2]
Text=Prohibir la profanación y consagrar el lugar con una plegaria
Result_pool=res_adv_exp_04_ign_vitelio:70,res_adv_exp_04_ign_queja:30

[OPTION_3]
Text=Interpretar los glifos sagrados para retirar reliquias sin ira divina
Requires=plan>=2
Result_pool=res_adv_exp_04_plan:100
