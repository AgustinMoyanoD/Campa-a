[OPTION_1]
Text=Enviar a Publio Varro con jinetes ligeros a cazarlos
Result_pool=res_mot_03_caza_clean:65,res_mot_03_caza_cost:35

[OPTION_2]
Text=Dejarlos marchar y redoblar las centinelas con los sargentos
