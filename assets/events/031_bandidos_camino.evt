[EVENT]
Id=event_bandidos_camino
Name=Partida Nocturna de Salteadores
Description=Un puñado de degolladores ágiles y letales emerge de la oscuridad. Son pocos pero conocen cada roca y atacan sin mediar palabra a los carros de cola.
Trigger=NIGHT
Time=NIGHT
Biome=PLAINS,FOREST,MOUNTAIN,DESERT
Probability=3
MinInfamy=0.0
MaxInfamy=100.0
MinGold=0
MinFood=0
MinWater=0
MinArmySize=0

[OPTION_1]
Text=Cerrar filas y presentar batalla en la oscuridad
Result_pool=res_bandidos_luchar:100

[OPTION_2]
Text=Arrojar bolsas de plata para distraer su codicia y forzar el paso
Requires=gold>=15
Result_pool=res_bandidos_pagar:100

[OPTION_3]
Text=Anticipar sus ángulos de emboscada y cazarlos entre las sombras
Requires=eval>=2
Result_pool=res_bandidos_emboscar:100
