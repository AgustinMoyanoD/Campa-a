[OPTION_2]
Text=Cerrar los cofres con llave: el oro es para víveres y armamento
Result_pool=res_mot_06_cerrar_clean:60,res_mot_06_cerrar_craso:40

[OPTION_3]
Text=Abonar una paga de estímulo y prometer el resto tras la victoria
Requires=eval>=2
